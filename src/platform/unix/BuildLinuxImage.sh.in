#!/bin/bash

export ROOT=$(echo $ROOT | grep . || pwd)
export NCORES=`nproc --all`

while getopts ":ih" opt; do
  case ${opt} in
    i )
        export BUILD_IMAGE="1"
        ;;
    h ) echo "Usage: ./BuildLinuxImage.sh [-i]"
        echo "   -i: Generate Appimage (optional)"
        exit 0
        ;;
  esac
done

echo -n "[9/9] Generating Linux app..."
#{
    # create directory and copy into it
    if [ -d "package" ]
    then
        rm -rf package/*
        rm -rf package/.* 2&>/dev/null
    else
        mkdir package
    fi
    mkdir package/bin

    # copy Resources
    cp -Rf ../resources package/resources
    #llvm-strip --strip-debug src/@SLIC3R_APP_CMD@
    cp -f src/@SLIC3R_APP_CMD@ package/bin/@SLIC3R_APP_CMD@
    # remove unneeded po from resources
    ## find package/resources/localization -name "*.po" -type f -delete ## FIXME: DD - do we need this?

    # create bin
cat << EOF >@SLIC3R_APP_CMD@
#!/bin/bash
DIR=\$(readlink -f "\$0" | xargs dirname)
export LD_LIBRARY_PATH="\$DIR/bin:\$DIR/usr/lib"

# FIXME: CrealityPrint segfault workarounds
# 1) CrealityPrint will segfault on systems where locale info is not as expected (i.e. Holo-ISO arch-based distro)
export LC_ALL=C

# 2) Wayland: under native GTK-Wayland the wxPopupTransientWindow based popups
#    (e.g. the sidebar filament selector) never appear. Run through XWayland
#    instead, the same workaround OrcaSlicer ships. Honour a user override.
if [ -z "\${GDK_BACKEND}" ] && [ -n "\${WAYLAND_DISPLAY}" ]; then
    export GDK_BACKEND=x11
fi

# 3) Hybrid iGPU/NVIDIA laptops: when libGLX_nvidia is installed but the
#    display is driven by the integrated GPU (and under XWayland, which cannot
#    tell libglvnd which vendor owns the screen), libglvnd may hand
#    glXCreateContext to the NVIDIA vendor library and the app dies with
#    "BadValue ... request_code 149 (GLX)". Prefer Mesa when the boot VGA
#    device is not NVIDIA. Honour a user override (e.g. PRIME render offload).
have_nvidia_glx=0
for f in /usr/lib/*/libGLX_nvidia.so.0 /usr/lib*/libGLX_nvidia.so.0; do
    [ -e "\$f" ] && have_nvidia_glx=1 && break
done
if [ -z "\${__GLX_VENDOR_LIBRARY_NAME}" ] && [ "\$have_nvidia_glx" = "1" ]; then
    for dev in /sys/class/drm/card*/device; do
        if [ "\$(cat "\$dev/boot_vga" 2>/dev/null)" = "1" ] && [ "\$(cat "\$dev/vendor" 2>/dev/null)" != "0x10de" ]; then
            export __GLX_VENDOR_LIBRARY_NAME=mesa
            break
        fi
    done
fi

# 4) Intel iGPUs (seen on Raptor Lake-U with Mesa 26.0.8): the first draw of
#    the G-code toolpath preview never completes when Mesa uses colour-
#    compressed (CCS) surfaces; i915 resets the context ("context reset due
#    to GPU hang") and iris deadlocks, leaving a black "Not Responding"
#    window after every slice. Disabling CCS for this process avoids it at a
#    small bandwidth cost. Honour a user-provided INTEL_DEBUG.
if [ -z "\${INTEL_DEBUG+x}" ]; then
    for dev in /sys/class/drm/card*/device; do
        if [ "\$(cat "\$dev/vendor" 2>/dev/null)" = "0x8086" ]; then
            export INTEL_DEBUG=noccs
            break
        fi
    done
fi

exec "\$DIR/bin/@SLIC3R_APP_CMD@" "\$@"
EOF

    chmod ug+x @SLIC3R_APP_CMD@
    cp -f @SLIC3R_APP_CMD@ package/@SLIC3R_APP_CMD@
    pushd package
    tar -cvf ../@SLIC3R_APP_KEY@.tar .  &>/dev/null
    popd
#} &> $ROOT/Build.log # Capture all command output
echo "done"

if [[ -n "$BUILD_IMAGE" ]]
then
echo -n "Creating Appimage for distribution..."
#{
    pushd package
    chmod +x ../build_appimage.sh
    ../build_appimage.sh
    popd
    mv package/"@SLIC3R_APP_NAME@-V@CREALITYPRINT_VERSION@-x86_64-@PROJECT_VERSION_EXTRA@.AppImage" "@SLIC3R_APP_NAME@-V@CREALITYPRINT_VERSION@-x86_64-@PROJECT_VERSION_EXTRA@.AppImage"
#} &> $ROOT/Build.log # Capture all command output
echo "done"
fi
